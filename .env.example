# Medha env — copy to .env and fill in. Never commit .env.
# Mirror these keys in the Modal Secret named "medha-secrets".

# Meta Model API key for the judge + escalation (Muse Spark 1.3).
# From https://dev.meta.ai/ ; format LLM|{id}|{secret}
META_API_KEY=
# Hugging Face token (Glimmer weight download at deploy time only)
HF_TOKEN=
# Bearer token gating /api/* (single demo user)
MEDHA_TOKEN=change-me-before-deploy
# Self-hosted Glimmer endpoint (set after `modal deploy medha/glimmer.py`)
GLIMMER_BASE_URL=
# Shared secret for the vLLM API key (exported as VLLM_API_KEY in the
# container, never passed on the vLLM command line; generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
GLIMMER_API_KEY=
GLIMMER_MODEL_ID=meta-models/Muse-Glimmer-30B
# TEMPORARY: glimmer | meta — which provider serves author-side roles.
# "meta" (Spark 1.3) until the Glimmer server boots; then flip to "glimmer".
LLM_AUTHOR_PROVIDER=meta
# Budget guards
DAILY_SPEND_CAP_USD=5
MAX_TOKENS_PER_TASK=60000
ALLOW_ESCALATION=0
# Deterministic free demo replay
DEMO_MODE=0
# Router / gate thresholds
ROUTE_MIN=0.6
HOLDOUT_MIN=0.8
# Local storage (Modal uses /data Volume instead)
MEDHA_DB_PATH=./medha_data/medha.db
MEDHA_SKILLS_DIR=./medha_data/skills
MEDHA_VERIFY_DIR=./medha_data/verify_store
